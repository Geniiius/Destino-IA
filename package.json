{
  "name": "destino-ia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Taller interactivo de IA Generativa para mentes creativas",
  "author": "Destino IA Labs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check-console": "npm run build && findstr /s /i \"console.log\" dist\\*.js || echo No console.log encontrados",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.vite",
    "slides": "npx tsx scripts/pdf-to-webp.ts",
    "slides:clean": "npx tsx scripts/pdf-to-webp.ts --clean",
    "slides:hq": "npx tsx scripts/pdf-to-webp.ts -q 90 -w 2560 -d 250 --clean"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.6",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "pdf2pic": "^3.2.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-remove-console": "^2.2.0"
  }
}
