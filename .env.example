# ============================================
# Destino IA - Configuration d'Environnement
# ============================================
# Copie ce fichier vers .env.local et configure les valeurs
#
# Solo PDF.js + Supabase - Sin funcionalidades de IA

# ============================================
# 🔄 Supabase (OPTIONNEL - pour le realtime)
# ============================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# ⚙️ Application
# ============================================
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0

# Feature flags
VITE_ENABLE_REALTIME=true
